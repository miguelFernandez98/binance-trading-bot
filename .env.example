# Copia este archivo a ".env" y completa tus credenciales.
# NUNCA subas el archivo .env a GitHub.

# API Key y Secret de tu cuenta Binance
# (Cuenta > API Management > Create API)
BINANCE_API_KEY=tu_api_key_aqui
BINANCE_API_SECRET=tu_api_secret_aqui

# Modo testnet: true = simula operaciones sin dinero real
# (requiere credenciales creadas en https://testnet.binance.vision)
BINANCE_TESTNET=false